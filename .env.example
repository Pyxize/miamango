# Neon Postgres connection string
# 1. Sign up at https://console.neon.tech (free tier: 500 MB, largely sufficient)
# 2. Create a project → copy the "connection string" from Dashboard
# 3. Paste below (keeps ?sslmode=require at the end)
#
# Example:
# EXPO_PUBLIC_NEON_URL=postgresql://user:PASSWORD@ep-cool-lake-12345.us-east-1.aws.neon.tech/reels?sslmode=require

EXPO_PUBLIC_NEON_URL=
